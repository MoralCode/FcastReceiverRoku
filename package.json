{
	"name": "fcast-roku-channel",
	"version": "0.1.0",
	"displayName": "FCast Roku Channel (Unofficial)",
	"scripts": {
		"deps": "ropm install",
		"build": "bsc",
		"build:dev": "bsc --project bsconfig-dev.json",
		"compile": "bsc --create-package false",
		"clean": "rm -r out/ dist/"
	},
	"dependencies": {
		"qrcode": "npm:@moralcode/qrcode-brightscript@^0.1.1",
		"brighterscript": "^0.70.3"
	},
	"devDependencies": {
		"ropm": "^0.11.5"
	},
	"ropm": {
		"rootDir": "src",
		"noprefix": [
			"qrcode"
		]
	}
}
